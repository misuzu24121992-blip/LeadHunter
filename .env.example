# ===== Verichains LeadHunter Configuration =====

# AI Scoring — pick ONE (Gemini recommended, it's FREE)
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-your-key-here

# Anthropic Claude (alternative): https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (alternative): https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here

# Telegram Bot (Required)
# Create bot via @BotFather on Telegram, get token
# Get chat_id by messaging bot then visiting:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Airtable (Required)
# Get from: https://airtable.com/create/tokens
AIRTABLE_API_KEY=pat-your-key-here
AIRTABLE_BASE_ID=your-base-id-here
AIRTABLE_PIPELINE_TABLE=Pipeline Tracker
AIRTABLE_WATCHLIST_TABLE=Watchlist

# GitHub (Optional but recommended - higher rate limits)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp-your-token-here

# DeFiLlama (No API key needed - free)

# RootData (Optional - may need API key for higher limits)
ROOTDATA_API_KEY=your-key-here
